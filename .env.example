# Job Search Template — Environment Variables
# Copy this file as .env and fill in your values
# NEVER version the .env file

# Anthropic API key (Claude)
# Get yours at: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets Tracker ID
# Obtained automatically on the first run of update_tracker.py
# (also in the sheet URL: docs.google.com/spreadsheets/d/{ID}/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1ABC...xyz

# Optional configuration
LOG_LEVEL=INFO
OUTPUT_DIR=outputs
JOBS_INBOX_DIR=jobs_inbox
JOBS_PARSED_DIR=jobs_parsed
